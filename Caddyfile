# =========================================================================
# 🌐 Production Caddy Reverse Proxy Configuration
# =========================================================================

# 1. Direct Public IP Access (Fallback & testing on Port 80)
:80 {
    # Route /trpc* to tRPC Backend
    handle /trpc* {
        reverse_proxy api:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote}
            header_up X-Forwarded-For {remote}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Next.js internal auth API routes (like /api/auth/logout) route to frontend
    handle /api/auth* {
        reverse_proxy web:3000
    }

    # Route /api* or /docs to Backend API
    handle /api* {
        reverse_proxy api:8000
    }
    handle /docs* {
        reverse_proxy api:8000
    }

    # All other traffic routes to Next.js Frontend
    handle {
        reverse_proxy web:3000
    }
}

# 2. Forms Subdomain (Next.js Frontend with Auto HTTPS)
chaiform.kenilpatel.in {
    reverse_proxy web:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
    }
}

# 3. API Subdomain (tRPC & OpenAPI Backend with Auto HTTPS)
api.kenilpatel.in {
    reverse_proxy api:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
    }
}
